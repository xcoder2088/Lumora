# Petit serveur web local pour Lumora (même principe que PixelDrop : il n'écoute que sur le serveur,
# c'est le tunnel Cloudflare existant qui le rend public).
[Unit]
Description=Lumora (site statique)
After=network-online.target

[Service]
Type=simple
DynamicUser=yes
ExecStart=/usr/bin/python3 -m http.server 8791 --bind 127.0.0.1 --directory /var/www/lumora
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/var/www/lumora

[Install]
WantedBy=multi-user.target
